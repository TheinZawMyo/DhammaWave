# Base URL of the Buddha Audio API.
# Leave empty in development to use the Vite proxy (/api -> http://127.0.0.1:8000).
VITE_API_BASE_URL=

# Public read-only API key (same key compiled into the Flutter app).
VITE_API_KEY=

# Where the Android APK is hosted. Point this at a CDN or the API server in production.
VITE_ANDROID_APK_URL=/downloads/dhammawave.apk

# Displayed on the download page.
VITE_APP_VERSION=1.0.0
VITE_ANDROID_APK_SIZE=60 MB
