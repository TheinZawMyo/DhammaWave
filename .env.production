# Production build — talks to the public API server.
VITE_API_BASE_URL=

# Public read-only API key (the same key compiled into the Flutter app).
VITE_API_KEY=

# Where the Android APK is hosted. Point this at a CDN or the API server.
VITE_ANDROID_APK_URL=/downloads/dhammawave.apk

# Displayed on the download page.
VITE_APP_VERSION=1.0.0
VITE_ANDROID_APK_SIZE=60 MB
