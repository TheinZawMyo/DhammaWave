# Local development — talks to the Laravel backend through the Vite proxy
# (see vite.config.ts: /api -> http://127.0.0.1:8000).
VITE_API_BASE_URL=

# API key registered in the local backend database.
VITE_API_KEY=dw_live_116a7f883a4d238e3344abeaf4f069b63d9846f55f3f5163f807b91a025afa19

# Where the Android APK is hosted.
VITE_ANDROID_APK_URL=/downloads/dhammawave.apk

# Displayed on the download page.
VITE_APP_VERSION=1.0.0
VITE_ANDROID_APK_SIZE=60 MB
